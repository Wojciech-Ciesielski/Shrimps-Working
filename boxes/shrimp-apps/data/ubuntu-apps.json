{
  "_": "Strona „Z Ubuntu” w Shrimp Apps (src/ubuntu.rs). Tylko aplikacje, których Flathub nie ma jako sprawdzonych (sklep pokazuje tylko sprawdzone), a które mają ponad min_downloads instalacji według statystyk Flathub (pole flathub = źródło liczby). CI (tools/check-ubuntu-apps.py) sprawdza na żywo: liczbę instalacji, brak weryfikacji na Flathub i pakiet w Ubuntu 24.04 (noble). Liczb nie wpisujemy ręcznie. exec = polecenie w kontenerze (distrobox-export --app).",
  "container": "shrimp-ubuntu",
  "image": "docker.io/library/ubuntu:24.04",
  "backup": "localhost/shrimp-ubuntu-backup:latest",
  "min_downloads": 1000000,
  "apps": [
    { "package": "vlc", "exec": "vlc", "name": "VLC", "flathub": "org.videolan.VLC", "category": "video" },
    { "package": "audacity", "exec": "audacity", "name": "Audacity", "flathub": "org.audacityteam.Audacity", "category": "music" },
    { "package": "inkscape", "exec": "inkscape", "name": "Inkscape", "flathub": "org.inkscape.Inkscape", "category": "graphics" },
    { "package": "remmina", "exec": "remmina", "name": "Remmina", "flathub": "org.remmina.Remmina", "category": "internet" },
    { "package": "darktable", "exec": "darktable", "name": "darktable", "flathub": "org.darktable.Darktable", "category": "graphics" },
    { "package": "shotcut", "exec": "shotcut", "name": "Shotcut", "flathub": "org.shotcut.Shotcut", "category": "video" },
    { "package": "freecad", "exec": "freecad", "name": "FreeCAD", "flathub": "org.freecad.FreeCAD", "category": "tools" },
    { "package": "torbrowser-launcher", "exec": "torbrowser-launcher", "name": "Tor Browser", "flathub": "org.torproject.torbrowser-launcher", "category": "internet" },
    { "package": "strawberry", "exec": "strawberry", "name": "Strawberry", "flathub": "org.strawberrymusicplayer.strawberry", "category": "music" }
  ]
}
